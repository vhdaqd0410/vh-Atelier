# Python
__pycache__/
*.pyc
*.pyo

# 大模型 / 引擎（不随仓库分发，运行时回退到旧字幕插件 CEP 目录或本机部署）
models/*.bin
models/funasr/
models/spleeter/
bin/whisper/
bin/sherpa/

# 大二进制（ffmpeg / yt-dlp 不入仓，部署时手动拷贝到 bin/）
bin/ffmpeg-win32-x64.exe
bin/yt-dlp.exe

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 网易云音乐服务依赖（ncm/node_modules 不入仓，部署时 npm install）
ncm/node_modules/

# 视频下载服务（cookie 凭证 + 下载产物不入仓）
video/.video_cookie
video/.video_cookies.txt
collect/video/

# 用户运行时数据（替换字典/热键映射/备份等，绝不入仓，否则会覆盖用户真实数据）
collect/replace_dict.json
collect/hotkey.json
collect/backup/
collect/*.log
collect/index.json
collect/searchIndex.json
collect/musiclib_tree.json
collect/musiclib.log
collect/opentab.json
collect/search.log
collect/sfx.log
collect/keyhook.log

# 超分站登录 token（用户凭证，绝不入仓）
collect/_enhance_*.json
py/_enhance_*.json
